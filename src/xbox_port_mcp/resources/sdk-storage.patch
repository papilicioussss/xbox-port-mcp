 #else
 #include <sys/socket.h>
 #include <sys/syscall.h>  // SYS_pidfd_open: glibc 2.44's <sys/pidfd.h> declares pidfd_open with C++
@@ -152,6 +155,30 @@ bool Boot(std::vector<uint8_t> xbe, const std::string& xbe_name, const std::stri
     LOGI("boot: kernel imports resolved, %u missing", missing);
 
     MountDefaults(game_dir, data_dir);
+    // Xbox title storage lives under the title ID on the data partition.
+    constexpr uint32_t kDontSetupHarddisk = 0x00000008;
+    if (!(img.init_flags & kDontSetupHarddisk)) {
+        char title[9];
+        std::snprintf(title, sizeof(title), "%08X", unsigned(img.title_id));
+        auto mount_title = [&](const char* drive, const char* area) {
+            std::string target = std::string("\\Device\\Harddisk0\\Partition1\\") + area + "\\" + title;
+            std::string host = ResolvePath(target, 0);
+            std::error_code ec;
+            if (!host.empty()) std::filesystem::create_directories(host, ec);
+            if (host.empty() || ec) {
+                LOGE("boot: cannot prepare %s title storage: %s", drive,
+                     host.empty() ? "unmapped data partition" : ec.message().c_str());
+                return false;
+            }
+            return CreateSymbolicLink(std::string("\\??\\") + drive, target);
+        };
+        if (!mount_title("U:", "UDATA") || !mount_title("T:", "TDATA")) return false;
+    }
+
+    // The image requests the utility cache before its entry point runs.
+    constexpr uint32_t kMountUtilityDrive = 0x00000001;
+    if (img.init_flags & kMountUtilityDrive)
+        CreateSymbolicLink("\\??\\Z:", "\\Device\\Harddisk0\\Partition5");
 
     // a quick reboot into this title left its launch data page behind
     g_launch_file = data_dir + "/launch.bin";
