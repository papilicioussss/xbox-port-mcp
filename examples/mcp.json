{
  "mcpServers": {
    "xbox-port": {
      "command": "C:/Tools/xbox-port-mcp/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "xbox_port_mcp"
      ],
      "env": {
        "XBOX_PORT_WORKSPACE_ROOT": "D:/XboxPorts",
        "XBOX_PORT_INPUT_ROOTS": "[\"D:/MyXboxGames\"]",
